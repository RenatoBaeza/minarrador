{
  "// note": "Main process, build scripts and tests: Node, CommonJS output. The renderer has its own projects under src/renderer.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "Node16",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
