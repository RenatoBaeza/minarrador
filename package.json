{
  "name": "minarrador",
  "productName": "Minarrador",
  "version": "1.0.0",
  "description": "Local-only meeting notes: records mic + system audio, transcribes and summarizes with Ollama on your machine.",
  "main": "src/main/main.js",
  "author": "Renato Baeza",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenatoBaeza/minarrador.git"
  },
  "bugs": {
    "url": "https://github.com/RenatoBaeza/minarrador/issues"
  },
  "homepage": "https://github.com/RenatoBaeza/minarrador#readme",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "icons": "node scripts/make-icons.js",
    "whisper:setup": "node scripts/setup-whisper.js",
    "pipeline": "electron scripts/run-pipeline.js",
    "capture-test": "electron scripts/capture-test.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "build": {
    "appId": "com.rntbz.minarrador",
    "productName": "Minarrador",
    "artifactName": "Minarrador-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minarrador",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
