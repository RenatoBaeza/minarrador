{
  "name": "minarrador",
  "productName": "Minarrador",
  "version": "1.0.0",
  "description": "Local-only meeting notes: records mic + system audio, transcribes and summarizes on your machine.",
  "author": "Renato Baeza",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenatoBaeza/minarrador.git"
  },
  "bugs": {
    "url": "https://github.com/RenatoBaeza/minarrador/issues"
  },
  "homepage": "https://github.com/RenatoBaeza/minarrador#readme",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:ui": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && tsc -p src/renderer/tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p src/renderer/tsconfig.json --noEmit",
    "lint": "eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "tauri dev",
    "dist": "tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
